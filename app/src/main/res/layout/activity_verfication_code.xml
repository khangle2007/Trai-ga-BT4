<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="500dp"
    android:layout_gravity="top"
    android:background="#FFFFFF"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/textView47"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="52dp"
        android:gravity="center"
        android:text="This makes your GrabPay\nWallet more secure."
        android:textColor="#363A44"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/edtOtpHidden"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:alpha="0"
        android:focusable="true"
        android:imeOptions="actionDone"
        android:importantForAccessibility="no"
        android:inputType="number"
        android:maxLength="6"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/etPin1"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="4dp"
        android:layout_marginTop="28dp"
        android:layout_weight="1"
        android:background="@drawable/edt_pin"
        android:gravity="center"
        android:text="-"
        android:textColor="@color/black"
        android:textSize="24dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/etPin2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView47" />

    <TextView
        android:id="@+id/etPin2"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="4dp"
        android:layout_weight="1"
        android:background="@drawable/edt_pin"
        android:gravity="center"
        android:text="-"
        android:textColor="@color/black"
        android:textSize="24dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/etPin3"
        app:layout_constraintStart_toEndOf="@+id/etPin1"
        app:layout_constraintTop_toTopOf="@+id/etPin1" />

    <TextView
        android:id="@+id/etPin3"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="4dp"
        android:layout_weight="1"
        android:background="@drawable/edt_pin"
        android:gravity="center"
        android:text="-"
        android:textColor="@color/black"
        android:textSize="24dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/etPin4"
        app:layout_constraintStart_toEndOf="@+id/etPin2"
        app:layout_constraintTop_toTopOf="@+id/etPin1" />

    <TextView
        android:id="@+id/etPin4"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="4dp"
        android:layout_weight="1"
        android:background="@drawable/edt_pin"
        android:gravity="center"
        android:text="-"
        android:textColor="@color/black"
        android:textSize="24dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/etPin5"
        app:layout_constraintStart_toEndOf="@+id/etPin3"
        app:layout_constraintTop_toTopOf="@+id/etPin1" />

    <TextView
        android:id="@+id/etPin5"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="4dp"
        android:layout_weight="1"
        android:background="@drawable/edt_pin"
        android:gravity="center"
        android:text="-"
        android:textColor="@color/black"
        android:textSize="24dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/etPin6"
        app:layout_constraintStart_toEndOf="@+id/etPin4"
        app:layout_constraintTop_toTopOf="@+id/etPin1" />

    <TextView
        android:id="@+id/etPin6"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="4dp"
        android:layout_weight="1"
        android:background="@drawable/edt_pin"
        android:gravity="center"
        android:text="-"
        android:textColor="@color/black"
        android:textSize="24dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/etPin5"
        app:layout_constraintTop_toTopOf="@+id/etPin1" />

    <TextView
        android:id="@+id/tvForgotPin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:gravity="center"
        android:text="FORGOT PIN?"
        android:textColor="#5B8EDC"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etPin1" />

</androidx.constraintlayout.widget.ConstraintLayout>